# Forum des Métiers & de l'Orientation — White-Label Environment Configuration

APP_ENV=development
APP_PORT=8190
DATABASE_URL=sqlite:///./forum_metiers.db
CORS_ORIGINS=["http://localhost:5190","http://127.0.0.1:5190","http://localhost:8190"]

# Security — change all secrets and default credentials before production deployment
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@etablissement.fr
ADMIN_PASSWORD=AdminForum2027!
ADMIN_SECRET_KEY=change_this_secret_key_in_production
STUDENT_TOKEN_SALT=change_this_token_salt_in_production

# Optional initial white-label school defaults (can also be edited directly in /admin/config)
DEFAULT_SCHOOL_NAME=Lycée Général et Technologique
DEFAULT_SCHOOL_SUBTITLE=Forum de l'Orientation
DEFAULT_SCHOOL_WEBSITE_URL=
DEFAULT_ENT_NAME=Pronote / ÉcoleDirecte

# Frontend dev API URL
VITE_API_URL=http://localhost:8190/api/v1
